{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["core/src/*"],
      "@editor/*": ["editor/src/*"],
      "@projects/*": ["projects/src/*"],
      "@runtime/*": ["runtime/src/*"]
    }
  },
  "include": [
    "core/src",
    "editor/src",
    "projects/src",
    "runtime/src",
    "vite.config.ts",
    "capacitor.config.ts"
  ]
}
